
# =========================================================
# ETAPA 1: FRONTEND - NODE.JS 22
# =========================================================

FROM node:22-bookworm-slim AS frontend

WORKDIR /app

# Copia as configurações do NPM
COPY package.json ./

# Instala as dependências do frontend
RUN npm install

# Copia os arquivos necessários para o Vite
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public

# Compila CSS e JavaScript para produção
RUN npm run build


# =========================================================
# ETAPA 2: BASE PHP - FRANKENPHP
# =========================================================

FROM dunglas/frankenphp:1-php8.4-bookworm AS base

WORKDIR /app

# Configura o PHP para produção
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Instala as extensões necessárias
RUN install-php-extensions \
    bcmath \
    mbstring \
    pdo_pgsql \
    intl \
    zip \
    opcache


# =========================================================
# ETAPA 3: DEPENDÊNCIAS DO LARAVEL - COMPOSER
# =========================================================

FROM base AS dependencies

# Copia o Composer para o ambiente
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copia os arquivos de dependências
COPY composer.json composer.lock ./

# Instala somente as dependências de produção
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

# Copia o restante do projeto
COPY . .

# Prepara as pastas utilizadas pelo Laravel
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    bootstrap/cache

# Gera o autoload e executa os scripts do Laravel
RUN composer dump-autoload \
    --no-dev \
    --classmap-authoritative


# =========================================================
# ETAPA 4: IMAGEM FINAL - PRODUÇÃO
# =========================================================

FROM base AS runtime

WORKDIR /app

# Copia o Laravel e suas dependências
COPY --from=dependencies --chown=www-data:www-data /app /app

# Copia os arquivos compilados pelo Node.js
COPY --from=frontend --chown=www-data:www-data /app/public/build /app/public/build

# Copia a configuração do servidor web
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

# Prepara permissões e diretórios
RUN mkdir -p \
    /app/storage/framework/cache \
    /app/storage/framework/sessions \
    /app/storage/framework/views \
    /app/bootstrap/cache \
    /config/caddy \
    /data/caddy \
    && chown -R www-data:www-data \
        /app/storage \
        /app/bootstrap/cache \
        /config/caddy \
        /data/caddy \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp

# Configurações de produção
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

# Executa com usuário sem privilégios de root
USER www-data

# Inicia o servidor FrankenPHP
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
